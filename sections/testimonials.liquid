<section class="testimonials" id="reviews">

  {%- comment -%} Decorative hearts {%- endcomment -%}
  <div class="testimonials__deco" aria-hidden="true">
    <span class="testimonials__heart testimonials__heart--1">♡</span>
    <span class="testimonials__heart testimonials__heart--2">♡</span>
    <span class="testimonials__heart testimonials__heart--3">✦</span>
  </div>

  <div class="container">
    <div class="section-header" data-aos="fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-desc">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      {%- comment -%} Overall rating badge {%- endcomment -%}
      <div class="testimonials__rating-badge" data-aos="zoom-in" data-aos-delay="100">
        <div class="testimonials__rating-stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24" width="18" height="18" style="color:#F4A020;fill:currentColor;">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          {%- endfor -%}
        </div>
        <span class="testimonials__rating-score">{{ section.settings.avg_rating | default: '4.9' }}</span>
        <span class="testimonials__rating-count">sur <strong>{{ section.settings.total_reviews | default: '847' }}</strong> avis vérifiés</span>
      </div>
    </div>
  </div>

  {%- comment -%} Row 1 — scrolls left {%- endcomment -%}
  <div class="testimonials-marquee" aria-label="Avis clients">
    <div class="testimonials-track" id="track-row1">
      {%- for block in section.blocks -%}
        {%- assign even = forloop.index | modulo: 2 -%}
        {%- if even == 1 or section.blocks.size < 4 -%}
          {%- render 'testimonial-card', block: block -%}
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign even = forloop.index | modulo: 2 -%}
        {%- if even == 1 or section.blocks.size < 4 -%}
          {%- render 'testimonial-card', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Row 2 — scrolls right (reverse) {%- endcomment -%}
  {%- if section.blocks.size >= 4 -%}
    <div class="testimonials-marquee testimonials-marquee--reverse">
      <div class="testimonials-track testimonials-track--reverse">
        {%- for block in section.blocks -%}
          {%- assign even = forloop.index | modulo: 2 -%}
          {%- if even == 0 -%}
            {%- render 'testimonial-card', block: block -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          {%- assign even = forloop.index | modulo: 2 -%}
          {%- if even == 0 -%}
            {%- render 'testimonial-card', block: block -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>

{% schema %}
{
  "name": "Témoignages",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texte au-dessus du titre",
      "default": "Avis clients"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Elles adorent Lisora"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre"
    },
    {
      "type": "text",
      "id": "avg_rating",
      "label": "Note moyenne",
      "default": "4.9"
    },
    {
      "type": "number",
      "id": "total_reviews",
      "label": "Nombre total d'avis",
      "default": 847
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Témoignage",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Note"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de l'avis",
          "default": "Incroyable !"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte de l'avis",
          "default": "Je suis complètement conquise par ce lisseur !"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Prénom",
          "default": "Sophie M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ville",
          "default": "Paris"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo de profil"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Témoignages",
      "blocks": [
        { "type": "testimonial", "settings": { "rating": 5, "title": "Le meilleur lisseur que j'ai eu !", "text": "Incroyable ! Mes cheveux sont lisses et brillants en 5 minutes. La qualité est au rendez-vous et le design est magnifique.", "name": "Sophie M.", "location": "Paris" } },
        { "type": "testimonial", "settings": { "rating": 5, "title": "Parfait pour mes cheveux bouclés", "text": "J'ai des cheveux très bouclés et difficiles à coiffer. Depuis que j'utilise Lisora, je gagne 20 minutes chaque matin !", "name": "Camille R.", "location": "Lyon" } },
        { "type": "testimonial", "settings": { "rating": 5, "title": "Design sublime et efficace", "text": "Le coloris rose est absolument adorable. Mes cheveux n'ont jamais été aussi lisses. Je recommande à 100% !", "name": "Emma L.", "location": "Bordeaux" } },
        { "type": "testimonial", "settings": { "rating": 5, "title": "Cadeau parfait", "text": "Je l'ai offert à ma sœur pour son anniversaire. Elle l'utilise tous les jours et ne peut plus s'en passer !", "name": "Juliette B.", "location": "Marseille" } },
        { "type": "testimonial", "settings": { "rating": 5, "title": "Rapport qualité/prix imbattable", "text": "Pour ce prix, la qualité est vraiment impressionnante. La chauffe est rapide, le glissement parfait. Très satisfaite !", "name": "Laura V.", "location": "Nantes" } },
        { "type": "testimonial", "settings": { "rating": 5, "title": "Livraison rapide et produit parfait", "text": "Reçu en 2 jours, emballage soigné et produit exactement comme décrit. Mes cheveux sont méconnaissables !", "name": "Chloé D.", "location": "Toulouse" } }
      ]
    }
  ]
}
{% endschema %}
