<header class="site-header" role="banner" id="site-header">
  {%- comment -%} Pink gradient top accent line {%- endcomment -%}
  <div class="site-header__topline" aria-hidden="true"></div>

  <div class="container">
    <div class="site-header__inner">

      {%- comment -%} LEFT — Navigation {%- endcomment -%}
      <nav class="site-header__nav" role="navigation" aria-label="Navigation principale">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links != blank -%}
            <div class="nav-item nav-item--dropdown">
              <a href="{{ link.url }}"
                 class="nav-link{% if link.active %} is-active{% endif %}"
                 aria-haspopup="true"
                 aria-expanded="false">
                {{ link.title }}
                <svg class="nav-arrow" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M1 1l4 4 4-4"/>
                </svg>
              </a>
              <div class="nav-dropdown" role="menu">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" class="nav-dropdown__link" role="menuitem">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ link.url }}"
               class="nav-link{% if link.active %} is-active{% endif %}"
               {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      {%- comment -%} CENTER — Logo (absolute pour centrage parfait) {%- endcomment -%}
      <div class="site-header__logo" aria-label="{{ shop.name }} — Retour à l'accueil">
        <a href="/" class="site-header__logo-link">
          {%- if settings.logo -%}
            <img
              src="{{ settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="{{ settings.logo_width }}"
              height="auto"
              loading="eager"
              class="site-header__logo-img"
            >
          {%- else -%}
            <span class="site-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      {%- comment -%} RIGHT — Actions {%- endcomment -%}
      <div class="site-header__actions">

        {%- comment -%} CTA pill — desktop only {%- endcomment -%}
        <a href="/products" class="header-cta-btn" aria-label="Commander Lisora">
          Commander
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a href="{{ routes.search_url }}" class="header-icon-btn" aria-label="Rechercher">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </a>

        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="Mon compte">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
        {%- endif -%}

        <button class="header-icon-btn cart-icon-btn" data-cart-trigger aria-label="Panier ({{ cart.item_count }} articles)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span class="cart-count" data-cart-count aria-hidden="true" data-count="{{ cart.item_count }}">
            {{ cart.item_count }}
          </span>
        </button>

        <button class="mobile-menu-btn" data-mobile-menu aria-label="Ouvrir le menu" aria-expanded="false">
          <span></span>
          <span></span>
          <span></span>
        </button>

      </div>
    </div>
  </div>

  {%- comment -%} Scroll progress bar {%- endcomment -%}
  <div class="site-header__progress" id="scroll-progress" aria-hidden="true"></div>
</header>

{%- comment -%} Mobile Menu — full-screen overlay {%- endcomment -%}
<div class="mobile-menu" role="dialog" aria-label="Menu mobile" aria-modal="true" id="mobile-menu">
  <div class="mobile-menu__backdrop" data-mobile-close></div>
  <div class="mobile-menu__panel">
    <div class="mobile-menu__header">
      <a href="/" class="mobile-menu__brand" data-mobile-close>{{ shop.name }}</a>
      <button class="mobile-menu__close" data-mobile-close aria-label="Fermer le menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Menu mobile">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"
           class="mobile-menu__link{% if link.active %} is-active{% endif %}"
           style="--delay: {{ forloop.index0 | times: 60 }}ms">
          <span class="mobile-menu__link-text">{{ link.title }}</span>
          <span class="mobile-menu__link-num">0{{ forloop.index }}</span>
        </a>
      {%- endfor -%}
    </nav>

    <div class="mobile-menu__cta">
      <a href="/products" class="btn btn-primary btn-full">
        Commander Lisora
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="mobile-menu__footer">
      <div class="mobile-menu__trust">
        <span>🚚 Livraison offerte dès 50€</span>
        <span>⭐ 4,9/5 · 50k+ clientes</span>
      </div>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="mobile-menu__account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15" height="15" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Mon compte
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu de navigation"
    }
  ]
}
{% endschema %}
