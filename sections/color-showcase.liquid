<section class="color-showcase">

  {%- comment -%} Decorative sparkles {%- endcomment -%}
  <div class="color-showcase__deco" aria-hidden="true">
    <span class="color-showcase__spark color-showcase__spark--1">✦</span>
    <span class="color-showcase__spark color-showcase__spark--2">✦</span>
    <span class="color-showcase__spark color-showcase__spark--3">◆</span>
    <span class="color-showcase__spark color-showcase__spark--4">✦</span>
  </div>

  <div class="container">
    <div class="section-header" data-aos="fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="section-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Color dot row preview {%- endcomment -%}
    <div class="color-showcase__dots" data-aos="fade-up" data-aos-delay="100" aria-hidden="true">
      {%- for block in section.blocks -%}
        <button
          class="color-showcase__dot"
          style="background:{{ block.settings.color | default: '#F4A7B3' }};"
          aria-label="{{ block.settings.name }}"
          data-index="{{ forloop.index0 }}"
          tabindex="-1"
        ></button>
      {%- endfor -%}
    </div>

    <div class="color-showcase__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.url | default: '#' }}"
          class="color-card"
          {{ block.shopify_attributes }}
          data-aos="fade-up"
          data-aos-delay="{{ forloop.index0 | times: 90 }}ms"
          aria-label="Découvrir le coloris {{ block.settings.name }}"
        >
          {%- if block.settings.image != blank -%}
            <img
              class="color-card__image"
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.name }}"
              loading="lazy"
              width="600"
            >
          {%- else -%}
            <div class="color-card__swatch" style="background:{{ block.settings.color | default: 'var(--color-secondary)' }};"></div>
          {%- endif -%}

          <div class="color-card__overlay" aria-hidden="true"></div>

          {%- comment -%} Shimmer sweep {%- endcomment -%}
          <div class="color-card__shimmer" aria-hidden="true"></div>

          <div class="color-card__info">
            <div class="color-card__dot" style="background:{{ block.settings.color | default: 'var(--color-secondary)' }};" aria-hidden="true"></div>
            <div class="color-card__name">{{ block.settings.name }}</div>
            <div class="color-card__link">
              Voir le coloris
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>

          {%- comment -%} Corner badge {%- endcomment -%}
          <div class="color-card__badge" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="color-showcase__cta" data-aos="fade-up" data-aos-delay="200">
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-primary">
          {{ section.settings.cta_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vitrine des coloris",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texte au-dessus du titre",
      "default": "Nos coloris"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Choisissez votre couleur"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "5 coloris exclusifs pour correspondre à votre personnalité."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Voir tous les coloris"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Coloris",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nom du coloris",
          "default": "Rose Poudré"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Couleur (si pas d'image)",
          "default": "#F4A7B3"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Lien vers le produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vitrine des coloris",
      "blocks": [
        { "type": "color", "settings": { "name": "Rose Poudré", "color": "#F4A7B3" } },
        { "type": "color", "settings": { "name": "Blanc Ivoire", "color": "#FAF0E6" } },
        { "type": "color", "settings": { "name": "Lilas Doux", "color": "#D8B4E2" } },
        { "type": "color", "settings": { "name": "Noir Minuit", "color": "#2C2C2C" } },
        { "type": "color", "settings": { "name": "Or Rosé", "color": "#C9856A" } }
      ]
    }
  ]
}
{% endschema %}
