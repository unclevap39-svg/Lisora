<div class="collection-header">
  <div class="container">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p style="max-width:600px;margin:16px auto 0;color:var(--color-text-light);">{{ collection.description }}</p>
    {%- endif -%}
  </div>
</div>

<div class="container">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-grid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p>Aucun produit trouvé.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="display:flex;justify-content:center;gap:8px;padding-bottom:60px;">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn btn-outline">← Précédent</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="btn btn-outline">{{ part.title }}</a>
          {%- else -%}
            <span class="btn btn-primary">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn-outline">Suivant →</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection principale",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Produits par page"
    }
  ]
}
{% endschema %}
