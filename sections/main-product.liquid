{%- assign product = product -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

<section class="product-section" data-product-section>
  <div class="container">
    <div class="product-layout">

      {%- comment -%} LEFT — Gallery {%- endcomment -%}
      <div class="product-gallery" data-aos="fade-right">
        <div class="product-gallery__main" data-gallery-main>
          {%- assign featured_image = selected_variant.featured_image | default: product.featured_image -%}
          <div class="product-gallery__img-wrap">
            <img
              src="{{ featured_image | image_url: width: 1000 }}"
              alt="{{ featured_image.alt | default: product.title }}"
              width="1000"
              loading="eager"
              id="main-product-image"
              class="product-gallery__img"
            >
            {%- if section.settings.badge != blank -%}
              <div class="product-gallery__badge">{{ section.settings.badge }}</div>
            {%- endif -%}
          </div>
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-src="{{ image | image_url: width: 1000 }}"
                data-alt="{{ image.alt | default: product.title }}"
                aria-label="Image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT — Product info {%- endcomment -%}
      <div class="product-info" data-aos="fade-left">

        {%- comment -%} Eyebrow badge {%- endcomment -%}
        <div class="product-info__eyebrow">
          <span class="product-info__eyebrow-dot" aria-hidden="true"></span>
          {{ section.settings.badge | default: '⚡ Bestseller · Édition limitée' }}
        </div>

        <h1 class="product-info__title">{{ product.title }}</h1>

        {%- comment -%} Rating {%- endcomment -%}
        <div class="product-info__rating" aria-label="{{ section.settings.avg_rating | default: '4.9' }} sur 5 étoiles">
          <div class="stars stars--filled" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg class="star" viewBox="0 0 24 24" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            {%- endfor -%}
          </div>
          <span class="product-info__rating-text">
            <strong>{{ section.settings.avg_rating | default: '4.9' }}</strong>
            <a href="#product-reviews" class="product-info__rating-link">({{ section.settings.review_count | default: 847 }} avis vérifiés)</a>
          </span>
        </div>

        {%- comment -%} Price {%- endcomment -%}
        <div class="product-info__price-row">
          <span class="product-info__price" data-product-price>{{ selected_variant.price | money }}</span>
          {%- if selected_variant.compare_at_price > selected_variant.price -%}
            <span class="product-info__compare" data-compare-price>{{ selected_variant.compare_at_price | money }}</span>
            {%- assign savings = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price -%}
            <span class="product-info__savings-badge">-{{ savings }}%</span>
          {%- endif -%}
        </div>

        {%- comment -%} Short selling description {%- endcomment -%}
        <p class="product-info__tagline">{{ section.settings.short_desc | default: 'Le lisseur céramique infrarouge qui transforme vos cheveux en 5 minutes. Résultat salon à domicile — garanti ou remboursé.' }}</p>

        {%- comment -%} Feature pills {%- endcomment -%}
        <div class="product-features-pills">
          <span class="product-feature-pill">⚡ Chauffe en 30s</span>
          <span class="product-feature-pill">💎 Céramique infrarouge</span>
          <span class="product-feature-pill">✨ Anti-frisottis</span>
          <span class="product-feature-pill">🌡️ Jusqu'à 230°C</span>
        </div>

        <script>window.__LISORA_PRODUCT__ = {{ product | json }};</script>

        <form action="/cart/add" method="post" data-product-form>
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_lower = option.name | downcase -%}
              {%- if opt_lower == 'couleur' or opt_lower == 'color' or opt_lower == 'colour' -%}
                <div class="color-picker" data-option="{{ option.name }}">
                  <div class="color-picker__label">
                    {{ option.name }} :
                    <span class="color-picker__selected" data-color-selected>{{ option.selected_value }}</span>
                  </div>
                  <div class="color-picker__swatches">
                    {%- assign color_map = 'Rose Poudré:#F4A7B3,Blanc Ivoire:#FAF0E6,Lilas Doux:#D8B4E2,Noir Minuit:#2C2C2C,Or Rosé:#C9856A' -%}
                    {%- for value in option.values -%}
                      {%- assign is_active = false -%}
                      {%- if option.selected_value == value -%}{%- assign is_active = true -%}{%- endif -%}
                      {%- assign swatch_color = '#F4A7B3' -%}
                      {%- for pair in color_map | split: ',' -%}
                        {%- assign kv = pair | split: ':' -%}
                        {%- if kv[0] == value -%}{%- assign swatch_color = kv[1] -%}{%- endif -%}
                      {%- endfor -%}
                      <button
                        type="button"
                        class="color-swatch{% if is_active %} is-active{% endif %}"
                        data-color-swatch
                        data-value="{{ value }}"
                        style="--swatch-bg: {{ swatch_color }};"
                        aria-label="{{ value }}"
                        title="{{ value }}"
                      >
                        <span class="color-swatch__inner" style="background: {{ swatch_color }};"></span>
                        <span class="color-swatch__check" aria-hidden="true">✓</span>
                        <span class="color-swatch__tooltip">{{ value }}</span>
                      </button>
                    {%- endfor -%}
                  </div>
                  <select name="options[{{ option.name | escape }}]" data-variant-select data-option="{{ option.name }}" class="visually-hidden">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- else -%}
                <div class="product-option">
                  <label class="product-option__label">
                    {{ option.name }} :
                    <span class="product-option__value" data-option-value="{{ option.name }}">{{ option.selected_value }}</span>
                  </label>
                  <select name="options[{{ option.name | escape }}]" data-variant-select data-option="{{ option.name }}" class="product-option__select">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}

          {%- comment -%} Quantity {%- endcomment -%}
          <div class="product-qty-row">
            <label class="product-qty-row__label" for="qty-{{ product.id }}">Quantité</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" data-qty-minus aria-label="Diminuer">−</button>
              <input type="number" id="qty-{{ product.id }}" name="quantity" value="1" min="1" class="quantity-input">
              <button type="button" class="quantity-btn" data-qty-plus aria-label="Augmenter">+</button>
            </div>
          </div>

          {%- comment -%} Urgency signal {%- endcomment -%}
          {%- if section.settings.show_urgency -%}
            <div class="product-urgency">
              <span class="product-urgency__dot" aria-hidden="true"></span>
              🔥 <strong>{{ section.settings.viewers | default: 23 }} personnes</strong> regardent ce produit en ce moment
            </div>
          {%- endif -%}

          {%- comment -%} CTA buttons {%- endcomment -%}
          <div class="product-form__btns">
            <button type="submit" class="btn btn-atc" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
              {%- if selected_variant.available -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                Ajouter au panier
              {%- else -%}
                Rupture de stock
              {%- endif -%}
            </button>
            {%- if section.settings.show_buy_now -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>

        </form>

        {%- comment -%} Trust icons row {%- endcomment -%}
        <div class="product-trust">
          <div class="product-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true">
              <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span>Livraison offerte dès 50€</span>
          </div>
          <div class="product-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true">
              <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
            <span>Retour gratuit 30 jours</span>
          </div>
          <div class="product-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Garantie 2 ans incluse</span>
          </div>
          <div class="product-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            <span>Paiement 100% sécurisé</span>
          </div>
        </div>

        {%- comment -%} Accordions: description + specs {%- endcomment -%}
        <div class="product-accordions">
          {%- if product.description != blank -%}
            <details class="product-accordion">
              <summary class="product-accordion__trigger">
                <span>Description complète</span>
                <svg class="product-accordion__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="product-accordion__body">{{ product.description }}</div>
            </details>
          {%- endif -%}

          <details class="product-accordion">
            <summary class="product-accordion__trigger">
              <span>Caractéristiques techniques</span>
              <svg class="product-accordion__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="product-accordion__body">
              <ul class="product-specs">
                <li><strong>Technologie</strong> : Céramique infrarouge avancée</li>
                <li><strong>Températures</strong> : 160°C – 230°C (ajustable)</li>
                <li><strong>Temps de chauffe</strong> : 30 secondes</li>
                <li><strong>Largeur des plaques</strong> : 32 mm — idéal tous types de cheveux</li>
                <li><strong>Longueur du câble</strong> : 2,5 m pivotant 360°</li>
                <li><strong>Arrêt automatique</strong> : Après 60 min d'inactivité</li>
                <li><strong>Compatible</strong> : Tous types de prises (EU/UK/US)</li>
                <li><strong>Garantie</strong> : 2 ans pièces & main d'œuvre</li>
              </ul>
            </div>
          </details>

          <details class="product-accordion">
            <summary class="product-accordion__trigger">
              <span>Livraison & Retours</span>
              <svg class="product-accordion__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="product-accordion__body">
              <ul class="product-specs">
                <li>🚚 <strong>Livraison offerte</strong> dès 50€ d'achat (France métropolitaine)</li>
                <li>📦 Expédition sous 24h – livraison en 2–3 jours ouvrés</li>
                <li>🔄 <strong>30 jours pour changer d'avis</strong> — retour gratuit et sans questions</li>
                <li>💰 Remboursement intégral sous 48h après réception du retour</li>
              </ul>
            </div>
          </details>
        </div>

      </div>{%- comment -%} end .product-info {%- endcomment -%}
    </div>{%- comment -%} end .product-layout {%- endcomment -%}
  </div>
</section>

{%- comment -%} ========== PRODUCT HIGHLIGHTS STRIP ========== {%- endcomment -%}
<section class="product-highlights">
  <div class="container">
    <div class="product-highlights__grid">
      <div class="product-highlight" data-aos="fade-up" data-aos-delay="0">
        <div class="product-highlight__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="product-highlight__title">Prêt en 30 secondes</h3>
        <p class="product-highlight__desc">Allumez, attendez 30s que la DEL passe au vert — température de salon atteinte. Zéro patience requise.</p>
      </div>
      <div class="product-highlight" data-aos="fade-up" data-aos-delay="80">
        <div class="product-highlight__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <h3 class="product-highlight__title">Zéro casse, zéro brûlure</h3>
        <p class="product-highlight__desc">La céramique infrarouge chauffe les cheveux de l'intérieur vers l'extérieur. Lissage parfait sans agression.</p>
      </div>
      <div class="product-highlight" data-aos="fade-up" data-aos-delay="160">
        <div class="product-highlight__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <h3 class="product-highlight__title">Ions négatifs actifs</h3>
        <p class="product-highlight__desc">Scellent les écailles de la tige capillaire pour une brillance miroir. Vos cheveux reflètent littéralement la lumière.</p>
      </div>
      <div class="product-highlight" data-aos="fade-up" data-aos-delay="240">
        <div class="product-highlight__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="product-highlight__title">Résultat qui tient</h3>
        <p class="product-highlight__desc">Anti-frisottis longue durée. Même par temps humide, vos cheveux restent lisses et brillants toute la journée.</p>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ========== STICKY ATC ========== {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  {%- if product.featured_image -%}
    <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title }}" width="56" height="56" class="sticky-atc__img" loading="lazy">
  {%- endif -%}
  <div class="sticky-atc__info">
    <div class="sticky-atc__title">{{ product.title }}</div>
    <div class="sticky-atc__price" data-sticky-price>{{ selected_variant.price | money }}</div>
  </div>
  <div class="stars stars--sm" aria-hidden="true">
    {%- for i in (1..5) -%}
      <svg class="star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    {%- endfor -%}
  </div>
  <button class="btn btn-atc sticky-atc__btn" data-sticky-atc-btn>
    Ajouter au panier
  </button>
</div>

{% schema %}
{
  "name": "Produit principal",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "⚡ Bestseller · Édition limitée"
    },
    {
      "type": "textarea",
      "id": "short_desc",
      "label": "Description courte (accroche)",
      "default": "Le lisseur céramique infrarouge qui transforme vos cheveux en 5 minutes. Résultat salon à domicile — garanti ou remboursé."
    },
    {
      "type": "text",
      "id": "avg_rating",
      "label": "Note moyenne",
      "default": "4.9"
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Nombre d'avis",
      "default": 847
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Afficher le bouton Acheter maintenant",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Afficher le signal d'urgence",
      "default": true
    },
    {
      "type": "number",
      "id": "viewers",
      "label": "Nombre de visiteurs (urgency)",
      "default": 23
    }
  ]
}
{% endschema %}
