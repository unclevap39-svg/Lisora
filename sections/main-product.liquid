{%- assign product = product -%}
{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- comment -%}
  Build color map from section blocks (type: color_swatch)
  Each block has: color_name (text) and color_hex (color picker)
{%- endcomment -%}

{%- comment -%} ═══════════════════════════════════════════════
    A — ATTENTION: Produit hero (dessus du pli)
═══════════════════════════════════════════════ {%- endcomment -%}

<section class="product-section" data-product-section aria-label="{{ product.title }}">
  <div class="container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="product-breadcrumb" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a>
      <span aria-hidden="true">›</span>
      <a href="/collections/all">Produits</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product-layout">

      {%- comment -%} ──── GALERIE ──── {%- endcomment -%}
      <div class="product-gallery" data-aos="fade-right">

        {%- comment -%} Main image {%- endcomment -%}
        <div class="product-gallery__main">
          {%- assign featured_image = selected_variant.featured_image | default: product.featured_image -%}
          <div class="product-gallery__img-wrap" id="gallery-main-wrap">
            <img
              src="{{ featured_image | image_url: width: 1000 }}"
              alt="{{ featured_image.alt | default: product.title }}"
              width="1000"
              loading="eager"
              id="main-product-image"
              class="product-gallery__img"
            >
            {%- if section.settings.badge != blank -%}
              <div class="product-gallery__badge">{{ section.settings.badge }}</div>
            {%- endif -%}
            {%- if selected_variant.compare_at_price > selected_variant.price -%}
              {%- assign savings_pct = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price -%}
              <div class="product-gallery__sale-badge">-{{ savings_pct }}%</div>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%} Thumbnails {%- endcomment -%}
        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs" role="list">
            {%- for image in product.images limit: 8 -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-src="{{ image | image_url: width: 1000 }}"
                data-alt="{{ image.alt | default: product.title }}"
                aria-label="Image {{ forloop.index }}"
                role="listitem"
              >
                <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ──── INFOS PRODUIT ──── {%- endcomment -%}
      <div class="product-info" data-aos="fade-left">

        {%- comment -%} ── A.1 Eyebrow badge ── {%- endcomment -%}
        {%- if section.settings.badge != blank or section.settings.show_badge_default -%}
          <div class="product-info__eyebrow">
            <span class="product-info__eyebrow-dot" aria-hidden="true"></span>
            {{ section.settings.badge | default: '⚡ Bestseller · Édition limitée' }}
          </div>
        {%- endif -%}

        {%- comment -%} ── A.2 Titre ── {%- endcomment -%}
        <h1 class="product-info__title">
          {%- if section.settings.product_headline != blank -%}
            {{ section.settings.product_headline }}
          {%- else -%}
            {{ product.title }}
          {%- endif -%}
        </h1>

        {%- comment -%} ── A.3 Évaluation + preuve sociale ── {%- endcomment -%}
        <div class="product-info__social-proof">
          <div class="product-info__rating" aria-label="{{ section.settings.avg_rating | default: '4.9' }} sur 5">
            <div class="stars stars--filled" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg class="star" viewBox="0 0 24 24" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              {%- endfor -%}
            </div>
            <span class="product-info__rating-score">{{ section.settings.avg_rating | default: '4.9' }}</span>
            <a href="#product-reviews" class="product-info__rating-count">{{ section.settings.review_count | default: 847 }} avis</a>
          </div>
          {%- if section.settings.customers_count != blank -%}
            <span class="product-info__proof-separator" aria-hidden="true">·</span>
            <span class="product-info__customers">{{ section.settings.customers_count }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} ── A.4 Prix ── {%- endcomment -%}
        <div class="product-info__price-row">
          <span class="product-info__price" data-product-price>{{ selected_variant.price | money }}</span>
          {%- if selected_variant.compare_at_price > selected_variant.price -%}
            <span class="product-info__compare" data-compare-price>{{ selected_variant.compare_at_price | money }}</span>
            <span class="product-info__savings-badge" data-savings-badge>-{{ savings_pct | default: 0 }}%</span>
          {%- endif -%}
        </div>

        {%- comment -%} ── A.5 Accroche courte (hook) ── {%- endcomment -%}
        {%- if section.settings.short_desc != blank -%}
          <p class="product-info__hook">{{ section.settings.short_desc }}</p>
        {%- endif -%}

        {%- comment -%} ── I.1 Feature pills (INTEREST) ── {%- endcomment -%}
        {%- assign pills = section.blocks | where: 'type', 'feature_pill' -%}
        {%- if pills.size > 0 -%}
          <div class="product-features-pills">
            {%- for block in pills -%}
              <span class="product-feature-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="product-features-pills">
            <span class="product-feature-pill">⚡ Chauffe en 30s</span>
            <span class="product-feature-pill">💎 Céramique infrarouge</span>
            <span class="product-feature-pill">✨ Anti-frisottis</span>
            <span class="product-feature-pill">🌡️ Jusqu'à 230°C</span>
          </div>
        {%- endif -%}

        <script>window.__LISORA_PRODUCT__ = {{ product | json }};</script>

        {%- comment -%} ── Formulaire (ACTION) ── {%- endcomment -%}
        <form action="/cart/add" method="post" data-product-form novalidate>
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}

              {%- comment -%} Chercher la config de cet option dans les blocks {%- endcomment -%}
              {%- assign opt_style = 'auto' -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'option_config' -%}
                  {%- assign block_name_lower = block.settings.option_name | downcase -%}
                  {%- assign opt_name_lower = option.name | downcase -%}
                  {%- if block_name_lower == opt_name_lower -%}
                    {%- assign opt_style = block.settings.display_style -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Auto-détection: couleur → swatches, sinon → buttons {%- endcomment -%}
              {%- if opt_style == 'auto' -%}
                {%- assign opt_lower = option.name | downcase -%}
                {%- if opt_lower == 'couleur' or opt_lower == 'color' or opt_lower == 'colour' -%}
                  {%- assign opt_style = 'swatches' -%}
                {%- else -%}
                  {%- assign opt_style = 'buttons' -%}
                {%- endif -%}
              {%- endif -%}

              <div class="variant-option" data-option="{{ option.name }}">
                <div class="variant-option__label">
                  <span class="variant-option__name">{{ option.name }}</span>
                  <span class="variant-option__selected" data-color-selected data-option-selected>{{ option.selected_value }}</span>
                </div>

                {%- if opt_style == 'swatches' -%}
                  {%- comment -%} Pastilles couleurs {%- endcomment -%}
                  <div class="variant-swatches">
                    {%- for value in option.values -%}
                      {%- assign is_active = false -%}
                      {%- if option.selected_value == value -%}{%- assign is_active = true -%}{%- endif -%}

                      {%- comment -%} Chercher la couleur hex dans les blocks {%- endcomment -%}
                      {%- assign swatch_hex = '#F4A7B3' -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'color_swatch' -%}
                          {%- if block.settings.color_name == value -%}
                            {%- assign swatch_hex = block.settings.color_hex -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}

                      <button
                        type="button"
                        class="color-swatch{% if is_active %} is-active{% endif %}"
                        data-color-swatch
                        data-value="{{ value | escape }}"
                        style="--swatch-bg: {{ swatch_hex }};"
                        aria-label="{{ value }}"
                        title="{{ value }}"
                      >
                        <span class="color-swatch__inner" style="background: {{ swatch_hex }};"></span>
                        <span class="color-swatch__check" aria-hidden="true">✓</span>
                        <span class="color-swatch__tooltip" aria-hidden="true">{{ value }}</span>
                      </button>
                    {%- endfor -%}
                  </div>

                {%- elsif opt_style == 'buttons' -%}
                  {%- comment -%} Boutons texte {%- endcomment -%}
                  <div class="variant-buttons">
                    {%- for value in option.values -%}
                      {%- assign is_active = false -%}
                      {%- if option.selected_value == value -%}{%- assign is_active = true -%}{%- endif -%}
                      <button
                        type="button"
                        class="variant-btn{% if is_active %} is-active{% endif %}"
                        data-variant-btn
                        data-value="{{ value | escape }}"
                        aria-label="{{ option.name }}: {{ value }}"
                        aria-pressed="{{ is_active }}"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>

                {%- else -%}
                  {%- comment -%} Menu déroulant {%- endcomment -%}
                  <select
                    name="options[{{ option.name | escape }}]"
                    data-variant-select
                    data-option="{{ option.name }}"
                    class="variant-dropdown"
                    aria-label="{{ option.name }}"
                  >
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                        {{ value }}
                      </option>
                    {%- endfor -%}
                  </select>

                {%- endif -%}

                {%- comment -%} Select caché pour synchronisation {%- endcomment -%}
                {%- unless opt_style == 'dropdown' -%}
                  <select
                    name="options[{{ option.name | escape }}]"
                    data-variant-select
                    data-option="{{ option.name }}"
                    class="visually-hidden"
                    aria-hidden="true"
                  >
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                {%- endunless -%}

              </div>
            {%- endfor -%}
          {%- endunless -%}

          {%- comment -%} Quantité {%- endcomment -%}
          <div class="product-qty-row">
            <label class="product-qty-row__label" for="qty-{{ product.id }}">Qté</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" data-qty-minus aria-label="Diminuer">−</button>
              <input type="number" id="qty-{{ product.id }}" name="quantity" value="1" min="1" max="99" class="quantity-input" aria-label="Quantité">
              <button type="button" class="quantity-btn" data-qty-plus aria-label="Augmenter">+</button>
            </div>
          </div>

          {%- comment -%} Signal d'urgence (D — Desire) {%- endcomment -%}
          {%- if section.settings.show_urgency -%}
            <div class="product-urgency">
              <span class="product-urgency__dot" aria-hidden="true"></span>
              🔥 <strong>{{ section.settings.viewers | default: 23 }} personnes</strong> regardent ce produit
            </div>
          {%- endif -%}

          {%- comment -%} Bouton ATC — ACTION {%- endcomment -%}
          <div class="product-form__btns">
            <button
              type="submit"
              class="btn btn-atc"
              data-add-to-cart
              {% unless selected_variant.available %}disabled aria-disabled="true"{% endunless %}
            >
              {%- if selected_variant.available -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18" aria-hidden="true">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                {{ section.settings.atc_text | default: 'Ajouter au panier' }}
              {%- else -%}
                Rupture de stock
              {%- endif -%}
            </button>
            {%- if section.settings.show_buy_now -%}
              <div class="product-buy-now">{{ form | payment_button }}</div>
            {%- endif -%}
          </div>

        </form>

        {%- comment -%} Icônes de confiance (ACTION — rassurance) {%- endcomment -%}
        <div class="product-trust">
          {%- assign trust_blocks = section.blocks | where: 'type', 'trust_item' -%}
          {%- if trust_blocks.size > 0 -%}
            {%- for block in trust_blocks -%}
              <div class="product-trust__item" {{ block.shopify_attributes }}>
                <span class="product-trust__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="product-trust__item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>Livraison offerte 50€</span>
            </div>
            <div class="product-trust__item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              <span>Retour 30 jours</span>
            </div>
            <div class="product-trust__item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Garantie 2 ans</span>
            </div>
            <div class="product-trust__item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              <span>Paiement sécurisé</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ── I.2 Accordéons (INTEREST — specs, description) ── {%- endcomment -%}
        <div class="product-accordions">

          {%- comment -%} Description éditeur de thème (priorité) OU description produit {%- endcomment -%}
          {%- assign display_description = section.settings.product_description -%}
          {%- if display_description == blank -%}
            {%- assign display_description = product.description -%}
          {%- endif -%}
          {%- if display_description != blank -%}
            <details class="product-accordion" open>
              <summary class="product-accordion__trigger">
                <span>{{ section.settings.desc_label | default: 'Description' }}</span>
                <svg class="product-accordion__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="product-accordion__body">{{ display_description }}</div>
            </details>
          {%- endif -%}

          {%- comment -%} Specs techniques — éditable via blocks {%- endcomment -%}
          {%- assign spec_blocks = section.blocks | where: 'type', 'spec_item' -%}
          {%- if spec_blocks.size > 0 -%}
            <details class="product-accordion">
              <summary class="product-accordion__trigger">
                <span>{{ section.settings.specs_label | default: 'Caractéristiques' }}</span>
                <svg class="product-accordion__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="product-accordion__body">
                <ul class="product-specs">
                  {%- for block in spec_blocks -%}
                    <li {{ block.shopify_attributes }}><strong>{{ block.settings.label }}</strong> : {{ block.settings.value }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            </details>
          {%- endif -%}

          <details class="product-accordion">
            <summary class="product-accordion__trigger">
              <span>{{ section.settings.shipping_label | default: 'Livraison & Retours' }}</span>
              <svg class="product-accordion__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="product-accordion__body">
              {%- if section.settings.shipping_text != blank -%}
                {{ section.settings.shipping_text }}
              {%- else -%}
                <ul class="product-specs">
                  <li>🚚 <strong>Livraison offerte</strong> dès 50€ · 2–3 jours ouvrés</li>
                  <li>🔄 <strong>30 jours</strong> pour changer d'avis — retour gratuit</li>
                  <li>💰 Remboursement intégral sous 48h</li>
                </ul>
              {%- endif -%}
            </div>
          </details>

        </div>

      </div>{%- comment -%} /product-info {%- endcomment -%}
    </div>{%- comment -%} /product-layout {%- endcomment -%}
  </div>
</section>

{%- comment -%} ═══════════════════════════════════════════════
    I — INTEREST: Bénéfices clés (strip iconique)
═══════════════════════════════════════════════ {%- endcomment -%}
{%- assign highlight_blocks = section.blocks | where: 'type', 'highlight' -%}
{%- if highlight_blocks.size > 0 or section.settings.show_default_highlights -%}
<section class="product-highlights" aria-label="Avantages clés">
  <div class="container">
    {%- if section.settings.highlights_title != blank -%}
      <div class="product-highlights__head" data-aos="fade-up">
        <h2 class="section-title--sm">{{ section.settings.highlights_title }}</h2>
      </div>
    {%- endif -%}
    <div class="product-highlights__grid">
      {%- if highlight_blocks.size > 0 -%}
        {%- for block in highlight_blocks -%}
          <div class="product-highlight" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
            <div class="product-highlight__icon" aria-hidden="true">{{ block.settings.icon }}</div>
            <h3 class="product-highlight__title">{{ block.settings.title }}</h3>
            <p class="product-highlight__desc">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="product-highlight" data-aos="fade-up">
          <div class="product-highlight__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="product-highlight__title">Prêt en 30 secondes</h3>
          <p class="product-highlight__desc">Température de salon atteinte en 30s. Zéro attente le matin.</p>
        </div>
        <div class="product-highlight" data-aos="fade-up" data-aos-delay="80">
          <div class="product-highlight__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="product-highlight__title">Zéro casse</h3>
          <p class="product-highlight__desc">Céramique infrarouge : chauffe de l'intérieur, aucune agression.</p>
        </div>
        <div class="product-highlight" data-aos="fade-up" data-aos-delay="160">
          <div class="product-highlight__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="product-highlight__title">Brillance miroir</h3>
          <p class="product-highlight__desc">Ions négatifs actifs — vos cheveux réfléchissent la lumière.</p>
        </div>
        <div class="product-highlight" data-aos="fade-up" data-aos-delay="240">
          <div class="product-highlight__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="product-highlight__title">Résultat toute la journée</h3>
          <p class="product-highlight__desc">Anti-frisottis longue durée, même par temps humide.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ═══════════════════════════════════════════════
    D — DESIRE: Mini-témoignages produit
═══════════════════════════════════════════════ {%- endcomment -%}
{%- assign review_blocks = section.blocks | where: 'type', 'mini_review' -%}
{%- if review_blocks.size > 0 -%}
<section class="product-reviews-mini" aria-label="Avis clients">
  <div class="container">
    <div class="product-reviews-mini__head" data-aos="fade-up">
      <h2 class="section-title--sm">{{ section.settings.reviews_title | default: 'Ce qu\'elles en pensent' }}</h2>
      <div class="product-reviews-mini__avg">
        <div class="stars stars--filled" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg class="star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {%- endfor -%}
        </div>
        <strong>{{ section.settings.avg_rating | default: '4.9' }}/5</strong>
        <span>— {{ section.settings.review_count | default: 847 }} avis vérifiés</span>
      </div>
    </div>
    <div class="product-reviews-mini__grid">
      {%- for block in review_blocks -%}
        <div class="product-review-card" data-aos="fade-up" data-aos-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          <div class="product-review-card__top">
            <div class="stars stars--filled stars--sm" aria-hidden="true">
              {%- for i in (1..5) -%}
                <svg class="star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endfor -%}
            </div>
            <span class="product-review-card__verified">✓ Achat vérifié</span>
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="product-review-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          <p class="product-review-card__text">"{{ block.settings.text }}"</p>
          <div class="product-review-card__author">
            <strong>{{ block.settings.author }}</strong>
            {%- if block.settings.location != blank -%} · {{ block.settings.location }}{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{%- comment -%} ═══════════════════════════════════════════════
    A — ACTION: Sticky ATC bar
═══════════════════════════════════════════════ {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc role="complementary" aria-label="Ajouter au panier rapide">
  {%- if product.featured_image -%}
    <img
      src="{{ product.featured_image | image_url: width: 120 }}"
      alt="{{ product.title }}"
      width="56" height="56"
      class="sticky-atc__img"
      loading="lazy"
    >
  {%- endif -%}
  <div class="sticky-atc__info">
    <div class="sticky-atc__title">{{ product.title }}</div>
    <div class="sticky-atc__price" data-sticky-price>{{ selected_variant.price | money }}</div>
  </div>
  <div class="stars stars--sm" aria-hidden="true">
    {%- for i in (1..5) -%}<svg class="star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endfor -%}
  </div>
  <button class="btn btn-atc sticky-atc__btn" data-sticky-atc-btn type="button">
    {{ section.settings.atc_text | default: 'Ajouter au panier' }}
  </button>
</div>

