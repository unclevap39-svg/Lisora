{%- assign product = product -%}

<section class="product-section">
  <div class="container">
    <div class="product-section__grid">

      {%- comment -%} Product Gallery {%- endcomment -%}
      <div class="product-gallery" data-aos="fade-right">
        <div class="product-gallery__main" data-gallery-main>
          {%- assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
          <img
            src="{{ featured_image | image_url: width: 900 }}"
            alt="{{ featured_image.alt | default: product.title }}"
            width="900"
            loading="eager"
            id="main-product-image"
          >
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-src="{{ image | image_url: width: 900 }}"
                data-alt="{{ image.alt | default: product.title }}"
                aria-label="Image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-info" data-aos="fade-left">
        <div class="product-info__badge">
          <span class="product-info__badge-dot" aria-hidden="true"></span>
          {{ section.settings.badge | default: 'Nouveauté · En stock' }}
        </div>

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__rating" aria-label="4.9 sur 5 étoiles">
          <div class="stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg class="star" viewBox="0 0 24 24">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            {%- endfor -%}
          </div>
          <span class="rating-count">
            <strong>4.9</strong>
            <a href="#reviews" class="rating-link">({{ section.settings.review_count | default: 247 }} avis)</a>
          </span>
        </div>

        {%- assign selected_variant = product.selected_or_first_available_variant -%}
        <div class="product-info__price-wrap">
          <span class="product-info__price" data-product-price>{{ selected_variant.price | money }}</span>
          {%- if selected_variant.compare_at_price > selected_variant.price -%}
            <span class="product-info__compare-price" data-compare-price>{{ selected_variant.compare_at_price | money }}</span>
            {%- assign savings = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price -%}
            <span class="product-info__savings">-{{ savings }}%</span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="product-info__short-desc">{{ product.description | strip_html | truncate: 200 }}</div>
        {%- endif -%}

        <script>window.__LISORA_PRODUCT__ = {{ product | json }};</script>

        <form action="/cart/add" method="post" data-product-form>
          <input type="hidden" name="id" value="{{ selected_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name_downcase = option.name | downcase -%}
              {%- if option_name_downcase == 'couleur' or option_name_downcase == 'color' -%}
                <div class="color-swatches" data-option="{{ option.name }}">
                  <div class="color-swatches__label">
                    {{ option.name }}
                    <span class="color-swatches__selected">{{ option.selected_value }}</span>
                  </div>
                  <div class="color-swatches__grid">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="color-swatch{% if option.selected_value == value %} is-active{% endif %}"
                        data-color-swatch
                        data-value="{{ value }}"
                        style="background-color:{{ value | handle | replace: '-', '' }};"
                        aria-label="{{ value }}"
                      >
                        <span class="color-swatch__tooltip">{{ value }}</span>
                      </button>
                    {%- endfor -%}
                  </div>
                  <select name="options[{{ option.name | escape }}]" data-variant-select data-option="{{ option.name }}" class="visually-hidden">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- else -%}
                <div style="margin-bottom:20px;">
                  <label style="display:block;font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;">
                    {{ option.name }}: <span style="font-weight:400;text-transform:none;">{{ option.selected_value }}</span>
                  </label>
                  <select name="options[{{ option.name | escape }}]" data-variant-select data-option="{{ option.name }}"
                    style="padding:12px 16px;border:2px solid rgba(44,24,16,0.15);border-radius:12px;font-size:0.9rem;width:100%;background:transparent;">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}

          <label class="product-form__quantity-label" for="quantity-{{ product.id }}">Quantité</label>
          <div class="quantity-selector">
            <button type="button" class="quantity-btn" data-qty-minus aria-label="Diminuer">−</button>
            <input type="number" id="quantity-{{ product.id }}" name="quantity" value="1" min="1" class="quantity-input">
            <button type="button" class="quantity-btn" data-qty-plus aria-label="Augmenter">+</button>
          </div>

          <div class="product-form__buttons">
            <button type="submit" class="btn-add-to-cart" data-add-to-cart {% unless selected_variant.available %}disabled{% endunless %}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              {%- if selected_variant.available -%}Ajouter au panier{%- else -%}Rupture de stock{%- endif -%}
            </button>
            {{ form | payment_button }}
          </div>
        </form>

        <div class="product-form__meta">
          <div class="product-form__meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            Livraison offerte dès 50€
          </div>
          <div class="product-form__meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            Paiement 100% sécurisé
          </div>
          <div class="product-form__meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
            Retour gratuit 30 jours
          </div>
        </div>

        {%- if product.description != blank -%}
          <details style="margin-top:24px;border-top:1px solid rgba(44,24,16,0.1);padding-top:20px;">
            <summary style="font-weight:600;font-size:0.9rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
              Description complète
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div style="margin-top:16px;font-size:0.9rem;line-height:1.8;color:var(--color-text-light);">
              {{ product.description }}
            </div>
          </details>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{%- comment -%} Sticky ATC {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc style="position:fixed;bottom:0;left:0;right:0;background:var(--color-background);border-top:1px solid rgba(44,24,16,0.1);padding:12px 24px;z-index:90;transform:translateY(100%);transition:transform 0.3s;display:flex;align-items:center;gap:16px;box-shadow:0 -4px 20px rgba(44,24,16,0.1);">
  {%- if product.featured_image -%}
    <img src="{{ product.featured_image | image_url: width: 80 }}" alt="{{ product.title }}" width="52" height="52" style="border-radius:8px;object-fit:cover;flex-shrink:0;">
  {%- endif -%}
  <div style="flex:1;min-width:0;">
    <div style="font-weight:600;font-size:0.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ product.title }}</div>
    <div style="font-size:0.82rem;color:var(--color-text-light);">{{ selected_variant.price | money }}</div>
  </div>
  <button class="btn-add-to-cart" style="width:auto;padding:12px 24px;font-size:0.8rem;flex-shrink:0;">Ajouter au panier</button>
</div>
<style>.sticky-atc.is-visible{transform:translateY(0)!important;}</style>

{% schema %}
{
  "name": "Produit principal",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Nouveauté · En stock"
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Nombre d'avis",
      "default": 247
    }
  ]
}
{% endschema %}
