<div class="cart-page">
  <div class="container">
    <h1 style="margin-bottom:40px;font-size:clamp(2rem,4vw,3rem);">Mon panier</h1>

    {%- if cart.item_count == 0 -%}
      <div style="text-align:center;padding:80px 0;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="width:80px;height:80px;margin:0 auto 24px;color:var(--color-secondary);">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <h2 style="font-size:1.8rem;margin-bottom:16px;">Votre panier est vide</h2>
        <p style="color:var(--color-text-light);margin-bottom:32px;">Découvrez nos produits et ajoutez-les à votre panier.</p>
        <a href="/collections/all" class="btn btn-primary btn-lg">Voir les produits</a>
      </div>
    {%- else -%}
      <div class="cart-page__grid">

        {%- comment -%} Cart items {%- endcomment -%}
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item" style="border-bottom:1px solid rgba(44,24,16,0.08);padding:20px 0;display:grid;grid-template-columns:100px 1fr auto;gap:20px;align-items:center;">
              <a href="{{ item.url }}" style="display:block;width:100px;height:100px;border-radius:12px;overflow:hidden;background:var(--color-secondary);">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" style="width:100%;height:100%;object-fit:cover;">
                {%- endif -%}
              </a>

              <div>
                <a href="{{ item.url }}" style="font-weight:600;font-size:1rem;color:var(--color-text);">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <div style="font-size:0.85rem;color:var(--color-text-light);margin-top:4px;">{{ item.variant.title }}</div>
                {%- endif -%}
                <div style="font-size:0.88rem;color:var(--color-text-light);margin-top:4px;">{{ item.variant.price | money }} / unité</div>

                <form action="/cart/change" method="post" style="margin-top:12px;display:inline-flex;align-items:center;gap:8px;">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <button
                    type="submit"
                    name="quantity"
                    value="{{ item.quantity | minus: 1 }}"
                    style="width:32px;height:32px;border:1px solid rgba(44,24,16,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;background:none;cursor:pointer;"
                    aria-label="Diminuer"
                  >−</button>
                  <span style="font-weight:600;min-width:24px;text-align:center;">{{ item.quantity }}</span>
                  <button
                    type="submit"
                    name="quantity"
                    value="{{ item.quantity | plus: 1 }}"
                    style="width:32px;height:32px;border:1px solid rgba(44,24,16,0.2);border-radius:50%;display:flex;align-items:center;justify-content:center;background:none;cursor:pointer;"
                    aria-label="Augmenter"
                  >+</button>
                </form>

                <form action="/cart/change" method="post" style="display:inline-block;margin-left:16px;">
                  <input type="hidden" name="line" value="{{ forloop.index }}">
                  <button type="submit" name="quantity" value="0" style="font-size:0.78rem;color:var(--color-text-light);text-decoration:underline;background:none;border:none;cursor:pointer;">
                    Supprimer
                  </button>
                </form>
              </div>

              <div style="font-weight:700;font-size:1.1rem;white-space:nowrap;">{{ item.line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Order Summary {%- endcomment -%}
        <div>
          <div style="background:var(--color-secondary);border-radius:20px;padding:32px;position:sticky;top:100px;">
            <h2 style="font-size:1.5rem;margin-bottom:24px;">Récapitulatif</h2>

            <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:0.9rem;">
              <span>Sous-total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:12px;font-size:0.9rem;color:var(--color-text-light);">
              <span>Livraison</span>
              <span>
                {%- if cart.total_price >= 5000 -%}
                  <span style="color:#22863a;font-weight:600;">Offerte</span>
                {%- else -%}
                  Calculée à l'étape suivante
                {%- endif -%}
              </span>
            </div>

            <div style="border-top:1px solid rgba(44,24,16,0.1);padding-top:16px;margin-top:16px;display:flex;justify-content:space-between;font-size:1.1rem;font-weight:700;margin-bottom:24px;">
              <span>Total</span>
              <span style="font-family:var(--font-heading);font-size:1.5rem;">{{ cart.total_price | money }}</span>
            </div>

            {%- if cart.total_price < 5000 -%}
              {%- assign remaining = 5000 | minus: cart.total_price -%}
              <div style="background:var(--color-background);border-radius:12px;padding:12px;font-size:0.82rem;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                🚚 Plus que <strong>{{ remaining | money }}</strong> pour la livraison offerte !
              </div>
            {%- endif -%}

            <a href="/checkout" class="btn btn-primary btn-full btn-lg" style="margin-bottom:12px;">
              Passer commande →
            </a>
            <a href="/collections/all" style="display:block;text-align:center;font-size:0.85rem;color:var(--color-text-light);text-decoration:underline;">
              Continuer mes achats
            </a>

            <div style="display:flex;gap:6px;justify-content:center;margin-top:20px;flex-wrap:wrap;">
              <span style="font-size:0.72rem;color:var(--color-text-light);display:flex;align-items:center;gap:4px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Paiement sécurisé SSL
              </span>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Panier principal"
}
{% endschema %}
