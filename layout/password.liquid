<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} - Bientôt disponible</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <div class="password-page">
      <div class="password-page__inner">
        <div class="password-page__logo">
          {%- if settings.logo -%}
            <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="200">
          {%- else -%}
            <span class="password-page__brand">{{ shop.name }}</span>
          {%- endif -%}
        </div>
        <h1 class="password-page__title">Bientôt disponible</h1>
        <p class="password-page__message">Quelque chose d'exceptionnel se prépare.</p>
        {{ content_for_layout }}
      </div>
    </div>
  </body>
</html>
